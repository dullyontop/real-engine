{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassFile",
  "description": "A class file: `classes/<area>.json`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "An optional `$schema` reference, ignored.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "description": "Always [`CLASS_FORMAT`].",
      "type": "string"
    },
    "version": {
      "description": "Always [`DATA_VERSION`].",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "classes": {
      "description": "The classes, in any order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClassDoc"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "classes"
  ],
  "$defs": {
    "ClassDoc": {
      "description": "One class, or (with `extend`) more members for a class declared in\nanother file, so each work package owns the rows it implements.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The class name (`Part`).",
          "type": "string"
        },
        "extend": {
          "description": "True to add members to a class declared elsewhere; then `superclass`,\n`creatable`, `service`, `components`, `status` and `doc` must be left out.",
          "type": "boolean"
        },
        "superclass": {
          "description": "The superclass name; only `Instance` has none.",
          "type": [
            "string",
            "null"
          ]
        },
        "creatable": {
          "description": "True if scripts may create it with `Instance.new`.",
          "type": "boolean"
        },
        "service": {
          "description": "True for a service: one instance under `game`, found by `GetService`.",
          "type": "boolean"
        },
        "components": {
          "description": "Native components every instance of the class gets (`Transform`), with\ntheir defaults.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "description": "How far the class as a whole is implemented (creating it, its\nbehaviour); members have their own status. Required unless `extend`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "description": "The gap, for `partial`.",
          "type": "string"
        },
        "doc": {
          "description": "What the class is, in our words.",
          "type": "string"
        },
        "properties": {
          "description": "Properties.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyDoc"
          }
        },
        "methods": {
          "description": "Methods.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodDoc"
          }
        },
        "events": {
          "description": "Events.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventDoc"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Status": {
      "description": "How far a class, member, enum or library is implemented.",
      "oneOf": [
        {
          "description": "Behaviour matches for the cases our tests cover.",
          "type": "string",
          "const": "implemented"
        },
        {
          "description": "Exists with a documented gap (see the row's `note`).",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Raises `RE9001` or `RE9002` with the member's name.",
          "type": "string",
          "const": "stub-error"
        },
        {
          "description": "Declared, not built yet.",
          "type": "string",
          "const": "missing"
        }
      ]
    },
    "PropertyDoc": {
      "description": "One property.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name (`Anchored`).",
          "type": "string"
        },
        "type": {
          "description": "The type: `bool`, `number`, `int`, `string`, `Vector3`, `Instance`,\n`Instance<Class>`, `Enum.<Name>` or a datatype name (`CFrame`).",
          "type": "string"
        },
        "storage": {
          "description": "Where the value lives.",
          "$ref": "#/$defs/StorageDoc"
        },
        "default": {
          "description": "The default for `own` storage, in the scene file's form; the type's\nzero value when left out."
        },
        "read_only": {
          "description": "True if scripts may only read it.",
          "type": "boolean"
        },
        "deprecated": {
          "description": "Set when the member is deprecated: what to use instead (`RE9101`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "How far it is implemented.",
          "$ref": "#/$defs/Status"
        },
        "note": {
          "description": "The gap, for `partial`.",
          "type": "string"
        },
        "doc": {
          "description": "What it means, in our words.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "storage",
        "status"
      ]
    },
    "StorageDoc": {
      "description": "Where a property's value lives.",
      "oneOf": [
        {
          "description": "A field of a native component (`Transform.translation`), optionally\nthrough a named converter that the implementing work package registers.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "alias"
            },
            "component": {
              "description": "The native component.",
              "type": "string"
            },
            "field": {
              "description": "Its field.",
              "type": "string"
            },
            "via": {
              "description": "A converter between the property's and the field's values.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "component",
            "field"
          ]
        },
        {
          "description": "A field of the class's own runtime component (`Compat_<Class>`), saved,\nundone and reflected like any other component field.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "own"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "Computed in Rust by a registered accessor (`Name`, `Parent`, `ClassName`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "builtin"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "MethodDoc": {
      "description": "One method.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name (`FindFirstChild`).",
          "type": "string"
        },
        "params": {
          "description": "The parameters after the instance itself.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamDoc"
          }
        },
        "returns": {
          "description": "The result types (empty for none).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "yields": {
          "description": "True if the call can yield the calling coroutine.",
          "type": "boolean"
        },
        "deprecated": {
          "description": "Set when the member is deprecated: what to use instead (`RE9101`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "How far it is implemented.",
          "$ref": "#/$defs/Status"
        },
        "note": {
          "description": "The gap, for `partial`.",
          "type": "string"
        },
        "doc": {
          "description": "What it does, in our words.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ]
    },
    "ParamDoc": {
      "description": "A parameter of a method or event.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name.",
          "type": "string"
        },
        "type": {
          "description": "The type, as for a property, plus `any`, `table`, `function` and `...`.",
          "type": "string"
        },
        "optional": {
          "description": "True if it may be left out.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "EventDoc": {
      "description": "One event.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name (`ChildAdded`).",
          "type": "string"
        },
        "params": {
          "description": "The values each firing passes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamDoc"
          }
        },
        "deprecated": {
          "description": "Set when the member is deprecated: what to use instead (`RE9101`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "How far it is implemented.",
          "$ref": "#/$defs/Status"
        },
        "note": {
          "description": "The gap, for `partial`.",
          "type": "string"
        },
        "doc": {
          "description": "When it fires, in our words.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ]
    }
  }
}

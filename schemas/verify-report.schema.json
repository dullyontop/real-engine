{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifyReport",
  "description": "The whole report (`schemas/verify-report.schema.json`).",
  "type": "object",
  "properties": {
    "ok": {
      "description": "True when every stage is ok.",
      "type": "boolean"
    },
    "stages": {
      "description": "The stages, in the order they ran.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StageReport"
      }
    },
    "perf": {
      "description": "The PerfReport of the boot run (absent when the project did not boot).",
      "anyOf": [
        {
          "$ref": "#/$defs/PerfReport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ok",
    "stages"
  ],
  "$defs": {
    "StageReport": {
      "description": "The result of one stage.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The stage name (`schema`, `compile`, `scan`, `net`, `boot`, `replays`, `goldens`, `perf`).",
          "type": "string"
        },
        "ok": {
          "description": "False when the stage found an error.",
          "type": "boolean"
        },
        "diagnostics": {
          "description": "Errors, warnings and notes.",
          "type": "array",
          "items": true
        },
        "duration_ms": {
          "description": "How long the stage took.",
          "type": "number",
          "format": "double"
        },
        "data": {
          "description": "Stage-specific results.",
          "default": null
        }
      },
      "required": [
        "name",
        "ok",
        "diagnostics",
        "duration_ms"
      ]
    },
    "PerfReport": {
      "description": "The performance report of a run.",
      "type": "object",
      "properties": {
        "frames": {
          "description": "Frames measured.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "frame": {
          "description": "Whole frames.",
          "$ref": "#/$defs/TimeStats"
        },
        "phases": {
          "description": "Each phase of ADR-0009, by name (`input`, `pre_render`, … `end_frame`).\nFixed-step phases are summed over the frame's steps.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/TimeStats"
          }
        },
        "physics_step": {
          "description": "One physics step: `Physics::step`, and in a compat game the server's parts\nand characters with their touch events, which step with it.",
          "$ref": "#/$defs/TimeStats"
        },
        "render_submit": {
          "description": "Drawing one frame on the CPU (ADR-0038): the renderer preparing,\nencoding and finishing the command buffers of the 3D view, a compat\ngame's surfaces and viewports, and the UI, which is what a render\nthread would take over. Waits for the GPU are not in it: presentation,\nreadback, and `Queue::submit` (`queue_submit`). Taken when frames are\ndrawn (in a window, and for captures), after the frame the phases\nmeasure.",
          "$ref": "#/$defs/TimeStats",
          "default": {
            "samples": 0,
            "mean_ms": 0.0,
            "p95_ms": 0.0,
            "max_ms": 0.0
          }
        },
        "queue_submit": {
          "description": "The frame's time inside `Queue::submit`. Software rasterisers and some\nGL drivers wait there until the GPU is done with the previous frame, so\nthere it mostly measures the GPU.",
          "$ref": "#/$defs/TimeStats",
          "default": {
            "samples": 0,
            "mean_ms": 0.0,
            "p95_ms": 0.0,
            "max_ms": 0.0
          }
        },
        "counts": {
          "description": "Counts at the end of the run.",
          "$ref": "#/$defs/PerfCounts"
        },
        "renderer": {
          "description": "What the renderer drew, when it drew a view.",
          "anyOf": [
            {
              "$ref": "#/$defs/RendererReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frames",
        "frame",
        "phases",
        "physics_step",
        "counts"
      ]
    },
    "TimeStats": {
      "description": "Mean, 95th percentile and maximum of a set of durations, in milliseconds.",
      "type": "object",
      "properties": {
        "samples": {
          "description": "The number of samples.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mean_ms": {
          "description": "Mean, in ms.",
          "type": "number",
          "format": "double"
        },
        "p95_ms": {
          "description": "95th percentile (nearest rank), in ms.",
          "type": "number",
          "format": "double"
        },
        "max_ms": {
          "description": "Maximum, in ms.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "samples",
        "mean_ms",
        "p95_ms",
        "max_ms"
      ]
    },
    "PerfCounts": {
      "description": "Counts taken at the end of the measured run.",
      "type": "object",
      "properties": {
        "entities": {
          "description": "Entities in the world.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "draw_items": {
          "description": "Items drawn in the last frame.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bodies": {
          "description": "Physics bodies (character inner bodies included).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "characters": {
          "description": "Physics characters.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "entities",
        "draw_items",
        "bodies",
        "characters"
      ]
    },
    "RendererReport": {
      "description": "What the renderer drew during the run and what it cost (ADR-0022's\namendment for WP32).",
      "type": "object",
      "properties": {
        "backend": {
          "description": "The wgpu backend (`vulkan`, `gl`, `metal`, `dx12`, `webgpu`).",
          "type": "string"
        },
        "adapter": {
          "description": "The adapter: its name, backend, type and driver.",
          "type": "string"
        },
        "frames": {
          "description": "The frames whose main view the renderer drew: a window's frames and\ncaptures.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "resources": {
          "description": "The live resources at the end of the run.",
          "$ref": "#/$defs/RendererResources"
        },
        "per_frame": {
          "description": "Each count of the renderer's `FrameStats` over the main views drawn,\nby name (`draw_calls`, `triangles`, `lights_dropped`, …).",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CountStats"
          }
        },
        "extra_views": {
          "description": "The other views drawn: a compat game's surfaces and viewports, an\neditor's scene view. Their counts are not in `per_frame`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "gpu_ms": {
          "description": "The GPU time of the passes of timed frames, where the device can time\nthem (not on GL). Measurements, not checks: times arrive a frame or\ntwo after their frame, and a frame whose readback is still in use is\nnot timed.",
          "anyOf": [
            {
              "$ref": "#/$defs/GpuPassTimes"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "description": "Every renderer warning of the views drawn, counted by code.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        }
      },
      "required": [
        "backend",
        "adapter",
        "frames",
        "resources",
        "per_frame",
        "extra_views",
        "warnings"
      ]
    },
    "RendererResources": {
      "description": "The renderer's live resources at the end of the run (`RenderStats`).",
      "type": "object",
      "properties": {
        "meshes": {
          "description": "Uploaded meshes.",
          "$ref": "#/$defs/ResourceCount"
        },
        "textures": {
          "description": "Uploaded textures.",
          "$ref": "#/$defs/ResourceCount"
        },
        "materials": {
          "description": "Created materials.",
          "$ref": "#/$defs/ResourceCount"
        }
      },
      "required": [
        "meshes",
        "textures",
        "materials"
      ]
    },
    "ResourceCount": {
      "description": "The live count and GPU bytes of one kind of renderer resource.",
      "type": "object",
      "properties": {
        "count": {
          "description": "Live resources.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "bytes": {
          "description": "GPU memory they use, in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "count",
        "bytes"
      ]
    },
    "CountStats": {
      "description": "Mean, 95th percentile and maximum of a count over frames.",
      "type": "object",
      "properties": {
        "mean": {
          "description": "Mean.",
          "type": "number",
          "format": "double"
        },
        "p95": {
          "description": "95th percentile (nearest rank).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max": {
          "description": "Maximum.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "mean",
        "p95",
        "max"
      ]
    },
    "GpuPassTimes": {
      "description": "The GPU time of a timed frame's passes, by group, over the timed frames.",
      "type": "object",
      "properties": {
        "shadow": {
          "description": "The shadow cascades.",
          "$ref": "#/$defs/TimeStats"
        },
        "scene": {
          "description": "The scene pass.",
          "$ref": "#/$defs/TimeStats"
        },
        "post": {
          "description": "The post chain.",
          "$ref": "#/$defs/TimeStats"
        },
        "overlay": {
          "description": "The highlights and the world quads drawn on top.",
          "$ref": "#/$defs/TimeStats"
        },
        "ui": {
          "description": "The UI painted over the frame.",
          "$ref": "#/$defs/TimeStats"
        },
        "total": {
          "description": "All of a frame's passes.",
          "$ref": "#/$defs/TimeStats"
        }
      },
      "required": [
        "shadow",
        "scene",
        "post",
        "overlay",
        "ui",
        "total"
      ]
    }
  }
}

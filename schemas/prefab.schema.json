{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real Engine prefab",
  "type": "object",
  "required": [
    "format",
    "version",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "real-engine/prefab"
    },
    "version": {
      "const": 1
    },
    "script_components": {
      "type": "array",
      "description": "Schemas of the script-defined components the saving world had registered.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "doc": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "default"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "bool",
                        "i32",
                        "i64",
                        "f32",
                        "f64",
                        "vec3",
                        "quat",
                        "color",
                        "string",
                        "entity",
                        "enum",
                        "list",
                        "map",
                        "record"
                      ]
                    },
                    "variants": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "item": {
                      "type": "object"
                    },
                    "record": {
                      "type": "string"
                    }
                  }
                },
                "default": {},
                "doc": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/]+$"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "components": {
            "type": "object",
            "properties": {
              "Transform": {
                "$ref": "#/$defs/Transform"
              },
              "MeshRef": {
                "$ref": "#/$defs/MeshRef"
              },
              "MaterialRef": {
                "$ref": "#/$defs/MaterialRef"
              },
              "Visible": {
                "$ref": "#/$defs/Visible"
              },
              "Camera": {
                "$ref": "#/$defs/Camera"
              },
              "Light": {
                "$ref": "#/$defs/Light"
              },
              "RigidBody": {
                "$ref": "#/$defs/RigidBody"
              },
              "Collider": {
                "$ref": "#/$defs/Collider"
              },
              "CharacterController": {
                "$ref": "#/$defs/CharacterController"
              },
              "ScriptRef": {
                "$ref": "#/$defs/ScriptRef"
              },
              "AudioSource": {
                "$ref": "#/$defs/AudioSource"
              },
              "AnimPlayer": {
                "$ref": "#/$defs/AnimPlayer"
              },
              "HudText": {
                "$ref": "#/$defs/HudText"
              },
              "Procedural": {
                "$ref": "#/$defs/Procedural"
              },
              "GraphSource": {
                "$ref": "#/$defs/GraphSource"
              },
              "Attributes": {
                "$ref": "#/$defs/Attributes"
              },
              "Tags": {
                "$ref": "#/$defs/Tags"
              },
              "SkinnedMesh": {
                "$ref": "#/$defs/SkinnedMesh"
              },
              "Streamed": {
                "$ref": "#/$defs/Streamed"
              },
              "StreamFocus": {
                "$ref": "#/$defs/StreamFocus"
              },
              "Vehicle": {
                "$ref": "#/$defs/Vehicle"
              },
              "VehicleWheel": {
                "$ref": "#/$defs/VehicleWheel"
              },
              "Ragdoll": {
                "$ref": "#/$defs/Ragdoll"
              },
              "Animator": {
                "$ref": "#/$defs/Animator"
              },
              "BoneAttachment": {
                "$ref": "#/$defs/BoneAttachment"
              }
            },
            "additionalProperties": false
          },
          "overrides": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "target",
                    "component",
                    "field",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "component": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "value": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "target",
                    "deleted"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "deleted": {
                      "const": true
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "target",
                    "moved"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "moved": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "parent": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "index": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "target",
                    "replaced"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "replaced": {
                      "type": "object",
                      "additionalProperties": false,
                      "oneOf": [
                        {
                          "required": [
                            "prefab"
                          ],
                          "not": {
                            "required": [
                              "components"
                            ]
                          }
                        },
                        {
                          "required": [
                            "components"
                          ],
                          "not": {
                            "required": [
                              "prefab"
                            ]
                          }
                        }
                      ],
                      "properties": {
                        "prefab": {
                          "type": "string",
                          "minLength": 1
                        },
                        "components": {
                          "type": "object"
                        },
                        "keep_children": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "insert"
                  ],
                  "additionalProperties": false,
                  "oneOf": [
                    {
                      "required": [
                        "prefab"
                      ],
                      "not": {
                        "required": [
                          "components"
                        ]
                      }
                    },
                    {
                      "required": [
                        "components"
                      ],
                      "not": {
                        "required": [
                          "prefab"
                        ]
                      }
                    }
                  ],
                  "properties": {
                    "prefab": {
                      "type": "string",
                      "minLength": 1
                    },
                    "components": {
                      "type": "object"
                    },
                    "insert": {
                      "type": "string",
                      "pattern": "^[^/+~][^/]*$"
                    },
                    "parent": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "index": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Transform": {
      "type": "object",
      "description": "Position, rotation and scale relative to the parent entity (or to the\nworld for a root entity).",
      "properties": {
        "translation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "Offset from the parent's origin, in metres."
        },
        "rotation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "description": "Orientation relative to the parent. Normalised on write."
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            1.0,
            1.0,
            1.0
          ],
          "description": "Per-axis scale relative to the parent."
        }
      },
      "additionalProperties": false
    },
    "MeshRef": {
      "type": "object",
      "description": "The mesh drawn for this entity.",
      "properties": {
        "asset": {
          "type": "string",
          "default": "",
          "description": "An asset path (`assets/crate.glb`), or `derived:<hash>` for a\nprocedurally generated mesh."
        }
      },
      "additionalProperties": false
    },
    "MaterialRef": {
      "type": "object",
      "description": "The material the mesh is drawn with.",
      "properties": {
        "asset": {
          "type": "string",
          "default": "",
          "description": "A material file path (`materials/stone.material.json`)."
        }
      },
      "additionalProperties": false
    },
    "Visible": {
      "type": "object",
      "description": "Whether the entity is drawn.",
      "properties": {
        "visible": {
          "type": "boolean",
          "default": true,
          "description": "False hides the entity (it still simulates)."
        }
      },
      "additionalProperties": false
    },
    "Camera": {
      "type": "object",
      "description": "A perspective camera. The active camera renders the frame.",
      "properties": {
        "fov_y_deg": {
          "type": "number",
          "default": 60.0,
          "description": "Vertical field of view, in degrees."
        },
        "near": {
          "type": "number",
          "default": 0.10000000149011612,
          "description": "Near clipping distance, in metres."
        },
        "far": {
          "type": "number",
          "default": 1000.0,
          "description": "Far clipping distance, in metres."
        },
        "active": {
          "type": "boolean",
          "default": false,
          "description": "True for the camera that renders the frame (one at a time)."
        }
      },
      "additionalProperties": false
    },
    "Light": {
      "type": "object",
      "description": "A light source. A directional light shines along the entity's -Z axis.",
      "properties": {
        "kind": {
          "enum": [
            "Directional",
            "Point"
          ],
          "default": "Point",
          "description": "Directional (sun-like) or point."
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 4,
          "default": [
            1.0,
            1.0,
            1.0,
            1.0
          ],
          "description": "Linear colour."
        },
        "intensity": {
          "type": "number",
          "default": 800.0,
          "description": "Intensity: lumens for point lights, lux for directional lights."
        },
        "range": {
          "type": "number",
          "default": 20.0,
          "description": "Distance in metres beyond which a point light has no effect."
        },
        "shadows": {
          "type": "boolean",
          "default": false,
          "description": "Whether the light casts shadows."
        }
      },
      "additionalProperties": false
    },
    "RigidBody": {
      "type": "object",
      "description": "Makes the entity a physics body. Needs a [`Collider`] to collide; a\n[`Collider`] without a `RigidBody` is a static body.",
      "properties": {
        "kind": {
          "enum": [
            "Static",
            "Dynamic",
            "Kinematic"
          ],
          "default": "Static",
          "description": "Static (never moves), dynamic (simulated) or kinematic (moved by code)."
        },
        "mass": {
          "type": "number",
          "default": 1.0,
          "description": "Mass in kilograms (dynamic bodies only)."
        },
        "friction": {
          "type": "number",
          "default": 0.5,
          "description": "Friction coefficient."
        },
        "restitution": {
          "type": "number",
          "default": 0.0,
          "description": "Restitution (bounciness), 0 to 1."
        },
        "linear_damping": {
          "type": "number",
          "default": 0.05000000074505806,
          "description": "Linear velocity damping per second."
        },
        "angular_damping": {
          "type": "number",
          "default": 0.05000000074505806,
          "description": "Angular velocity damping per second."
        },
        "center_of_mass_offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "Moves the centre of mass from the shape's own, in the body's local\nspace, in metres (dynamic bodies only). A vehicle chassis lowers it to\nstay upright."
        }
      },
      "additionalProperties": false
    },
    "Collider": {
      "type": "object",
      "description": "A collision shape, in the entity's local space.\n\n`re_app` maps it to a `re_types::physics::BodyDesc`: without a\n[`RigidBody`] the body is static, and `enabled = false` removes the body.\n`Mesh` and `Heightfield` shapes are static only (`re_physics` refuses them\non dynamic and kinematic bodies with `RE5003`).",
      "properties": {
        "shape": {
          "enum": [
            "Box",
            "Sphere",
            "Capsule",
            "Convex",
            "Mesh",
            "Heightfield"
          ],
          "default": "Box",
          "description": "The shape kind."
        },
        "half_extents": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0.5,
            0.5,
            0.5
          ],
          "description": "Half extents of a box, in metres."
        },
        "radius": {
          "type": "number",
          "default": 0.5,
          "description": "Radius of a sphere or capsule, in metres."
        },
        "half_height": {
          "type": "number",
          "default": 0.5,
          "description": "Half height of a capsule's cylindrical part, in metres."
        },
        "source": {
          "type": "string",
          "default": "",
          "description": "The mesh or heightfield asset for Convex, Mesh and Heightfield shapes. A\nheightfield asset carries its sample count per side (`n`), `spacing` and\n`offset` as well as the samples."
        },
        "layer": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 0,
          "description": "Object layer, 0 to 65535 (`re_types::physics::Layer`); the physics layer\ntable decides which layers collide."
        },
        "groups": {
          "type": "integer",
          "default": 1,
          "description": "Collision group bit mask, 0 to `u32::MAX` (`re_types::physics::GroupMask`:\nbit `g` is group `g`, so the default 1 is group 0). Queries and characters\nonly see bodies whose groups intersect theirs."
        },
        "sensor": {
          "type": "boolean",
          "default": false,
          "description": "A sensor reports contacts but does not collide."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "False removes the body from the simulation."
        }
      },
      "additionalProperties": false
    },
    "CharacterController": {
      "type": "object",
      "description": "A kinematic character (Jolt CharacterVirtual).",
      "properties": {
        "height": {
          "type": "number",
          "default": 1.7999999523162842,
          "description": "Total height, in metres."
        },
        "radius": {
          "type": "number",
          "default": 0.4000000059604645,
          "description": "Capsule radius, in metres."
        },
        "max_slope_deg": {
          "type": "number",
          "default": 45.0,
          "description": "Steepest walkable slope, in degrees."
        },
        "step_height": {
          "type": "number",
          "default": 0.30000001192092896,
          "description": "Highest step climbed without jumping, in metres."
        },
        "mass": {
          "type": "number",
          "default": 70.0,
          "description": "Mass in kilograms, used when pushing bodies."
        },
        "inner_body": {
          "type": "boolean",
          "default": true,
          "description": "True adds an inner rigid body, so the character takes part in contact events."
        },
        "layer": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 0,
          "description": "Object layer, 0 to 65535, as in [`Collider`]."
        },
        "groups": {
          "type": "integer",
          "default": 1,
          "description": "Collision group bit mask, 0 to `u32::MAX`, as in [`Collider`]. The\ncharacter only collides with bodies whose groups intersect these."
        }
      },
      "additionalProperties": false
    },
    "ScriptRef": {
      "type": "object",
      "description": "A Luau script attached to the entity.",
      "properties": {
        "path": {
          "type": "string",
          "default": "",
          "description": "Script path relative to the project (`scripts/game/player.luau`)."
        },
        "context": {
          "enum": [
            "Game",
            "Tools",
            "Server",
            "Client",
            "Module"
          ],
          "default": "Game",
          "description": "The context (VM) the script runs in."
        }
      },
      "additionalProperties": false
    },
    "AudioSource": {
      "type": "object",
      "description": "A sound emitter.",
      "properties": {
        "clip": {
          "type": "string",
          "default": "",
          "description": "A project asset path such as `assets/sfx/pickup.wav`, as in `AudioCmd`."
        },
        "volume": {
          "type": "number",
          "default": 1.0,
          "description": "Linear volume, 0 to 1."
        },
        "looping": {
          "type": "boolean",
          "default": false,
          "description": "Restart the clip when it ends."
        },
        "spatial": {
          "type": "boolean",
          "default": true,
          "description": "Attenuate and pan by the entity's position."
        },
        "autoplay": {
          "type": "boolean",
          "default": false,
          "description": "Start playing when the entity appears."
        },
        "bus": {
          "type": "string",
          "default": "",
          "description": "The mixer bus it plays on (ADR-0041); empty for the project's\n`default_bus`."
        }
      },
      "additionalProperties": false
    },
    "AnimPlayer": {
      "type": "object",
      "description": "Plays a node animation clip from a glTF asset.",
      "properties": {
        "clip": {
          "type": "string",
          "default": "",
          "description": "`<model asset path>#<clip name>`, e.g. `assets/models/door.glb#open`; the\nclip name is `ClipData.name` (the glTF animation name, or\n`animation_<index>`). Playback time is runtime state in `re_app`, not a\nfield."
        },
        "speed": {
          "type": "number",
          "default": 1.0,
          "description": "Playback speed multiplier."
        },
        "looping": {
          "type": "boolean",
          "default": true,
          "description": "Restart the clip when it ends."
        },
        "playing": {
          "type": "boolean",
          "default": true,
          "description": "Whether the clip advances."
        }
      },
      "additionalProperties": false
    },
    "HudText": {
      "type": "object",
      "description": "A line of text drawn on the heads-up display.",
      "properties": {
        "text": {
          "type": "string",
          "default": "",
          "description": "The text."
        },
        "anchor": {
          "enum": [
            "TopLeft",
            "Top",
            "TopRight",
            "Center",
            "BottomLeft",
            "Bottom",
            "BottomRight"
          ],
          "default": "TopLeft",
          "description": "Screen anchor."
        },
        "size": {
          "type": "number",
          "default": 18.0,
          "description": "Font size in logical pixels."
        }
      },
      "additionalProperties": false
    },
    "Procedural": {
      "type": "object",
      "description": "Makes this entity the source of generated entities.",
      "properties": {
        "generator": {
          "type": "string",
          "default": "",
          "description": "Name of a registered generator."
        },
        "seed": {
          "type": "integer",
          "default": 0,
          "description": "Seed for the generator's random choices."
        },
        "version": {
          "type": "integer",
          "default": 1,
          "description": "The generator version this source was written for (ADR-0043).\nThe generator runs as that version; files without the field\nmean 1."
        }
      },
      "additionalProperties": false
    },
    "GraphSource": {
      "type": "object",
      "description": "Parameters of the `graph` generator (a ProcGraph, ARCHITECTURE §5).\nNames either a `builder` script or a `graph` file.",
      "properties": {
        "graph": {
          "type": "string",
          "default": "",
          "description": "A graph file (`graphs/island.graph.json`)."
        },
        "builder": {
          "type": "string",
          "default": "",
          "description": "A builder script in the tools context (`scripts/tools/island_graph.luau`)."
        },
        "params": {
          "type": "string",
          "default": "",
          "description": "Per-node parameter overrides as canonical JSON:\n`{\"<node id>\": {\"<param>\": <value>}}`."
        }
      },
      "additionalProperties": false
    },
    "Attributes": {
      "type": "object",
      "description": "Named values attached to the entity by scripts, the editor or agents.",
      "properties": {
        "values": {
          "type": "object",
          "description": "The attributes by name. Values are bools, numbers, strings, vectors, colours, enum names, records, or lists of those.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
                  "boolean",
                  "number",
                  "string"
                ]
              },
              {
                "type": "object",
                "required": [
                  "$type",
                  "value"
                ],
                "properties": {
                  "$type": {
                    "enum": [
                      "vec3",
                      "quat",
                      "color",
                      "list",
                      "record"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "value": {}
                },
                "additionalProperties": false
              }
            ]
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Tags": {
      "type": "object",
      "description": "String labels on the entity, found through the tag index.",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "The tags, each at most once, in the order they were added."
        }
      },
      "additionalProperties": false
    },
    "SkinnedMesh": {
      "type": "object",
      "description": "A skinned mesh from a glTF asset, posed by its skeleton (ADR-0039).\n\nThe skeleton starts at its rest pose; an [`AnimPlayer`] on the same\nentity plays a clip onto its joints, matched by joint name. Joints are\nnot entities.",
      "properties": {
        "asset": {
          "type": "string",
          "default": "",
          "description": "`<model asset path>#<skin name>`, e.g. `assets/models/hero.glb#Armature`;\nthe skin name is `SkinData.name` (the glTF skin name, or `skin_<index>`)."
        }
      },
      "additionalProperties": false
    },
    "Streamed": {
      "type": "object",
      "description": "Streams this entity by cell (ADR-0042). On a procedural source (which\nmust have an identity transform), its generator's output is applied\nper cell; on an authored root entity, the entity and its subtree are\nunloaded with the cell holding its translation.",
      "properties": {
        "bounds": {
          "type": "number",
          "default": 0.0,
          "description": "For a procedural source: the half side, in metres, of the square\naround the world origin it generates (cells touching it are its\ncells); 0 is unbounded. Unused on authored entities."
        }
      },
      "additionalProperties": false
    },
    "StreamFocus": {
      "type": "object",
      "description": "A point the streamed world loads around: the player, a vehicle, the\neditor camera. With none, the active camera is the focus.",
      "properties": {},
      "additionalProperties": false
    },
    "Vehicle": {
      "type": "object",
      "description": "Makes a dynamic [`RigidBody`] a wheeled vehicle chassis (ADR-0040). Its\nwheels are the child entities with a [`VehicleWheel`], in child order;\neach wheel's [`Transform`] when the vehicle is created is its attachment\npoint, and `re_app` writes the simulated wheel pose back to it. Scripts\ndrive it with `physics.drive`.",
      "properties": {
        "kind": {
          "enum": [
            "Wheeled",
            "Motorcycle"
          ],
          "default": "Wheeled",
          "description": "Wheeled (any number of wheels) or motorcycle (two wheels that lean)."
        },
        "max_torque": {
          "type": "number",
          "default": 500.0,
          "description": "Engine torque at full throttle, in newton metres."
        },
        "min_rpm": {
          "type": "number",
          "default": 1000.0,
          "description": "Idle engine speed, in revolutions per minute."
        },
        "max_rpm": {
          "type": "number",
          "default": 6000.0,
          "description": "Highest engine speed, in revolutions per minute."
        },
        "gears": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            2.6600000858306885,
            1.7799999713897705,
            1.2999999523162842,
            1.0,
            0.7400000095367432
          ],
          "description": "Forward gear ratios, first gear first."
        },
        "reverse_gears": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "default": [
            -2.9000000953674316
          ],
          "description": "Reverse gear ratios (negative)."
        },
        "shift_up_rpm": {
          "type": "number",
          "default": 4000.0,
          "description": "Engine speed that shifts up, in revolutions per minute."
        },
        "shift_down_rpm": {
          "type": "number",
          "default": 2000.0,
          "description": "Engine speed that shifts down, in revolutions per minute."
        },
        "differential_ratio": {
          "type": "number",
          "default": 3.4200000762939453,
          "description": "Ratio between gearbox and driven wheels."
        },
        "anti_roll_stiffness": {
          "type": "number",
          "default": 1000.0,
          "description": "Anti-roll bar stiffness on each two-wheel axle; 0 adds none."
        },
        "max_pitch_roll_deg": {
          "type": "number",
          "default": 180.0,
          "description": "Steepest pitch or roll the chassis may reach, in degrees; 180 is free."
        },
        "tester": {
          "enum": [
            "Ray",
            "CastSphere",
            "CastCylinder"
          ],
          "default": "Ray",
          "description": "How the wheels find the ground."
        },
        "tester_radius": {
          "type": "number",
          "default": 0.30000001192092896,
          "description": "Sphere radius of the `CastSphere` tester, in metres."
        }
      },
      "additionalProperties": false
    },
    "VehicleWheel": {
      "type": "object",
      "description": "One wheel of the [`Vehicle`] on the entity's parent.",
      "properties": {
        "radius": {
          "type": "number",
          "default": 0.30000001192092896,
          "description": "Radius, in metres."
        },
        "width": {
          "type": "number",
          "default": 0.10000000149011612,
          "description": "Width, in metres."
        },
        "suspension_min": {
          "type": "number",
          "default": 0.30000001192092896,
          "description": "Shortest suspension length, in metres."
        },
        "suspension_max": {
          "type": "number",
          "default": 0.5,
          "description": "Longest suspension length, in metres."
        },
        "suspension_frequency": {
          "type": "number",
          "default": 1.5,
          "description": "Suspension spring frequency, in hertz."
        },
        "suspension_damping": {
          "type": "number",
          "default": 0.5,
          "description": "Suspension damping ratio."
        },
        "max_steer_deg": {
          "type": "number",
          "default": 0.0,
          "description": "Steering angle at full steer, in degrees; 0 does not steer."
        },
        "max_brake_torque": {
          "type": "number",
          "default": 1500.0,
          "description": "Brake torque at full brake, in newton metres."
        },
        "max_hand_brake_torque": {
          "type": "number",
          "default": 0.0,
          "description": "Hand brake torque, in newton metres; 0 has no hand brake."
        },
        "driven": {
          "type": "boolean",
          "default": false,
          "description": "True if the engine drives this wheel."
        }
      },
      "additionalProperties": false
    },
    "Ragdoll": {
      "type": "object",
      "description": "Gives a [`SkinnedMesh`] a ragdoll on its skeleton (ADR-0040). Once the skin\nloads, `re_app` generates the parts (one capsule per listed joint along its\nbone, humanoid joint limits, the mass split by volume), keeps an animated\nragdoll on the animation, and shows the simulated pose blended in while it is\nsimulated or powered. Scripts switch it with `physics.ragdoll`. The entity\nhas no `RigidBody`; a `CharacterController` on it is fine and never collides\nwith its own ragdoll.",
      "properties": {
        "joints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "The joints that get parts, by name; empty finds a humanoid's hips, spine,\nhead, upper arms, forearms, thighs and shins by name."
        },
        "total_mass": {
          "type": "number",
          "default": 70.0,
          "description": "Total mass, in kilograms."
        },
        "mode": {
          "enum": [
            "Animated",
            "Simulated",
            "Powered"
          ],
          "default": "Animated",
          "description": "How it moves when the scene starts, and after each edit of this field."
        },
        "strength": {
          "type": "number",
          "default": 1.0,
          "description": "Motor strength in `Powered` mode, 0 (limp) to 1."
        },
        "blend_seconds": {
          "type": "number",
          "default": 0.20000000298023224,
          "description": "Seconds the shown pose takes to blend from the animation to the ragdoll\nand back; 0 switches at once."
        }
      },
      "additionalProperties": false
    },
    "Animator": {
      "type": "object",
      "description": "Plays an animation graph (ADR-0039, `*.animgraph.json`) on the\n[`SkinnedMesh`] of the same entity, in place of an [`AnimPlayer`].\nParameters and state-machine state are runtime state in `re_app`;\nscripts reach them through the `anim` library.",
      "properties": {
        "graph": {
          "type": "string",
          "default": "",
          "description": "The graph file, e.g. `anims/hero.animgraph.json`."
        },
        "playing": {
          "type": "boolean",
          "default": true,
          "description": "Whether the graph advances; while false the pose holds."
        },
        "speed": {
          "type": "number",
          "default": 1.0,
          "description": "Playback speed multiplier for the whole graph (0 or more)."
        }
      },
      "additionalProperties": false
    },
    "BoneAttachment": {
      "type": "object",
      "description": "Places this entity at a joint of its parent's [`SkinnedMesh`] each\nfixed step: its `Transform` becomes the joint's model-space transform,\nwhich is relative to the parent because the skin's space is the\nparent's (ADR-0039). Put an offset on a child of this entity. It is\nplaced at the end of the step, after physics and the ragdoll blend, so\n`PostSimulation` scripts see the previous step's placement.",
      "properties": {
        "joint": {
          "type": "string",
          "default": "",
          "description": "The joint's name in the parent's skin."
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnumFile",
  "description": "An enum file: `enums/<area>.json`.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "An optional `$schema` reference, ignored.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "description": "Always [`ENUM_FORMAT`].",
      "type": "string"
    },
    "version": {
      "description": "Always [`DATA_VERSION`].",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "enums": {
      "description": "The enum types.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnumDoc"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "enums"
  ],
  "$defs": {
    "EnumDoc": {
      "description": "One enum type (`Material`).",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name, as in `Enum.<name>`.",
          "type": "string"
        },
        "items": {
          "description": "The items, in value order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnumItemDoc"
          }
        },
        "status": {
          "description": "How far scripts can use it (`Enum.<name>.<item>`, `GetEnumItems`).",
          "$ref": "#/$defs/Status"
        },
        "note": {
          "description": "The gap, for `partial`.",
          "type": "string"
        },
        "doc": {
          "description": "What it chooses, in our words.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "items",
        "status"
      ]
    },
    "EnumItemDoc": {
      "description": "One enum item.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name (`Plastic`).",
          "type": "string"
        },
        "value": {
          "description": "The number (`EnumItem.Value`).",
          "type": "integer",
          "format": "int64"
        },
        "deprecated": {
          "description": "Set when the item is deprecated: what to use instead.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ]
    },
    "Status": {
      "description": "How far a class, member, enum or library is implemented.",
      "oneOf": [
        {
          "description": "Behaviour matches for the cases our tests cover.",
          "type": "string",
          "const": "implemented"
        },
        {
          "description": "Exists with a documented gap (see the row's `note`).",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Raises `RE9001` or `RE9002` with the member's name.",
          "type": "string",
          "const": "stub-error"
        },
        {
          "description": "Declared, not built yet.",
          "type": "string",
          "const": "missing"
        }
      ]
    }
  }
}

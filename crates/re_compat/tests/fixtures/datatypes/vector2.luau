local a = Vector2.new(3, 4)
assert(typeof(a) == "Vector2")
assert(a.X == 3 and a.Y == 4 and a.Magnitude == 5)
assert(a.Unit == Vector2.new(0.6, 0.8))
assert(a + Vector2.one == Vector2.new(4, 5))
assert(a - Vector2.one == Vector2.new(2, 3))
assert(a * 2 == Vector2.new(6, 8) and 2 * a == Vector2.new(6, 8))
assert(a * Vector2.new(2, 3) == Vector2.new(6, 12))
assert(a / 2 == Vector2.new(1.5, 2))
assert(-a == Vector2.new(-3, -4))
assert(a:Dot(Vector2.new(1, 1)) == 7)
assert(Vector2.xAxis:Cross(Vector2.yAxis) == 1)
assert(Vector2.zero:Lerp(a, 0.5) == Vector2.new(1.5, 2))
assert(Vector2.new(-1.5, 2.5):Floor() == Vector2.new(-2, 2))
assert(a:Min(Vector2.new(5, 1)) == Vector2.new(3, 1))
assert(math.abs(Vector2.xAxis:Angle(Vector2.yAxis) - math.pi / 2) < 1e-6)
assert(Vector2.yAxis:Angle(Vector2.xAxis, true) < 0)
assert(a:FuzzyEq(Vector2.new(3, 4.000001)))
assert(tostring(a) == "3, 4")
assert(Vector2.new() == Vector2.zero)
local ok = pcall(function()
	return (a :: any).Z
end)
assert(not ok)

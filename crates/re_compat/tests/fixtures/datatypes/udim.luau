local u = UDim.new(0.5, 10)
assert(typeof(u) == "UDim" and u.Scale == 0.5 and u.Offset == 10)
assert(UDim.new(0, 10.9).Offset == 10)
assert(u + UDim.new(0.25, 5) == UDim.new(0.75, 15))
assert(u - UDim.new(0.5, 10) == UDim.new(0, 0))
assert(tostring(u) == "0.5, 10")

local p = UDim2.new(0.5, 10, 1, -20)
assert(typeof(p) == "UDim2")
assert(p.X == UDim.new(0.5, 10) and p.Y.Offset == -20)
assert(p.Width == p.X and p.Height == p.Y)
assert(UDim2.fromScale(0.5, 1) == UDim2.new(0.5, 0, 1, 0))
assert(UDim2.fromOffset(100, 50) == UDim2.new(0, 100, 0, 50))
assert(UDim2.new(UDim.new(1, 2), UDim.new(3, 4)) == UDim2.new(1, 2, 3, 4))
assert(UDim2.new() == UDim2.new(0, 0, 0, 0))
assert(p + UDim2.fromOffset(5, 5) == UDim2.new(0.5, 15, 1, -15))
assert(UDim2.new(0, 0, 0, 0):Lerp(UDim2.new(1, 100, 1, 100), 0.5) == UDim2.new(0.5, 50, 0.5, 50))
assert(tostring(p) == "{0.5, 10}, {1, -20}")

local r = Rect.new(0, 0, 100, 50)
assert(typeof(r) == "Rect" and r.Width == 100 and r.Height == 50)
assert(r.Min == Vector2.zero and r.Max == Vector2.new(100, 50))
assert(Rect.new(Vector2.zero, Vector2.new(100, 50)) == r)

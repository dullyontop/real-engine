--!strict
-- engine.d.luau: the Real Engine native Luau API.
-- Generated by re_script::api::definitions(); do not edit.
-- Load it with: luau-lsp analyze --definitions=@engine=engine.d.luau --flag:LuauSolverV2=true

-- A handle to an entity. The same entity is always the same value.
declare extern type Entity with
    -- The entity's stable id, or nil for an entity without one.
    read id: string?
    -- The display name (empty when it has none).
    read name: string
    -- False once the entity was despawned.
    read alive: boolean
    -- Reads a component field by name, e.g. e:get("Transform", "translation").
    function get(self, component: string, field: string): any
    -- Writes a component field by name; numbers are coerced to the field type.
    function set(self, component: string, field: string, value: any): ()
    -- True when the entity has the component.
    function has(self, component: string): boolean
    -- Adds (or replaces) a component; unspecified fields take their defaults.
    function add(self, component: string, fields: { [string]: any }?): ()
    -- Removes a component (nothing happens when it is absent).
    function remove(self, component: string): ()
    -- The children, in order.
    function children(self): { Entity }
    -- The parent, or nil for a root.
    function parent(self): Entity?
    -- Where the entity is drawn: translation, rotation and scale in the world. A moving physics body, and everything under it, is drawn between its last two steps; anything else where the world has it. In time.on_late_frame it is this frame's pose, in time.on_frame the last frame's (what is on screen). Frame-only: an error in a fixed step (RE3026).
    function drawn_transform(self): (vector, Quat, vector)
    -- Despawns the entity and its subtree. A generated entity stays gone after a regeneration.
    function destroy(self): ()
    function __eq(self, other: Entity): boolean
    function __tostring(self): string
end

declare extern type Quat with
    read x: number
    read y: number
    read z: number
    read w: number
    function inverse(self): Quat
    function rotate(self, v: vector): vector
    function to_euler(self): (number, number, number)
    -- q1 * q2 composes rotations; q * v rotates a vector.
    __mul: ((Quat, Quat) -> Quat) & ((Quat, vector) -> vector)
    function __eq(self, other: Quat): boolean
    function __tostring(self): string
end

declare extern type Color with
    read r: number
    read g: number
    read b: number
    read a: number
    function __eq(self, other: Color): boolean
    function __tostring(self): string
end

-- A connected callback.
declare extern type Connection with
    -- False once disconnected.
    read connected: boolean
    -- Stops further calls.
    function disconnect(self): ()
end

-- A ProcGraph being recorded by a builder script.
declare extern type Graph with
    read name: string
    read seed: number
    -- Adds a node. `inputs` maps input ports to nodes or ports; `id` defaults to n1, n2, ...
    -- The node records version 1 of its kind; write 'kind@2' to ask for version 2.
    function node(self, kind: string, params: { [string]: any }?, inputs: { [string]: GraphNode | GraphPort }?, id: string?): GraphNode
    -- Connects an output to a node's input port.
    function connect(self, from: GraphNode | GraphPort, to: GraphNode, port: string): ()
end

-- A node of a Graph; as an input it stands for its "out" port.
declare extern type GraphNode with
    read id: string
    read kind: string
    -- A named output port of this node.
    function out(self, port: string): GraphPort
end

-- An output port of a GraphNode.
declare extern type GraphPort with
    read node: string
    read port: string
end

-- A scene load started by scene.switch or scene.load.
declare extern type SceneLoad with
    -- The scene's name.
    read name: string
    -- How far the load got, from 0 to 1.
    read progress: number
    -- True once the load is over, applied or failed.
    read done: boolean
    -- Why the load failed (nothing changed then), or nil.
    read error: string?
    -- Suspends this script thread until the load is over; returns at once when it is.
    function wait(self): ()
end

-- Entities, components and the scene.
declare world: {
    -- The entity with this stable id, or nil.
    get: (id: string) -> Entity?,
    -- The entity at a path of names such as "Island/Crates/Crate_3", or nil (a convenience, not an identity).
    find: (path: string) -> Entity?,
    -- Every entity that has all the named components, ordered by stable id.
    query: (...string) -> { Entity },
    -- Spawns a runtime entity (with a fresh stable id unless one is given) and its components.
    spawn: (spec: { id: string?, name: string?, parent: Entity?, components: { [string]: { [string]: any } }? }?) -> Entity,
    -- Declares a script component, e.g. define_component("Collectible", { value = "i32" }). Defining the same shape again is allowed.
    define_component: (name: string, fields: { [string]: string | { type: string, default: any?, doc: string?, variants: { string }? } }) -> (),
    -- Asks the runtime to reload the entry scene at the end of the frame.
    restart: () -> (),
}

-- Rotations.
declare quat: {
    -- The rotation that does nothing.
    identity: () -> Quat,
    -- A rotation from angles in radians: yaw `y`, then pitch `x`, then roll `z`.
    from_euler: (x: number, y: number, z: number) -> Quat,
    -- A rotation of `angle` radians around `axis` (normalised here).
    from_axis_angle: (axis: vector, angle: number) -> Quat,
    -- The rotation that turns -Z towards `forward`, keeping `up` (default +Y) up.
    look_at: (forward: vector, up: vector?) -> Quat,
    -- Spherical interpolation from `a` (t = 0) to `b` (t = 1).
    slerp: (a: Quat, b: Quat, t: number) -> Quat,
}

-- Linear RGBA colours.
declare color: {
    -- A linear colour; alpha defaults to 1.
    new: (r: number, g: number, b: number, a: number?) -> Color,
}

-- Input actions from real.toml [input].
declare input: {
    -- True while the button action is held.
    down: (action: string) -> boolean,
    -- True on the frame the button action went down.
    pressed: (action: string) -> boolean,
    -- True on the frame the button action went up.
    released: (action: string) -> boolean,
    -- An axis action as vector(x, y, 0); zero when the action is unknown.
    axis: (action: string) -> vector,
    -- Calls `f` (in its own thread) each frame the button action goes down.
    on_pressed: (action: string, f: () -> ()) -> Connection,
    -- Calls `f` (in its own thread) each frame the button action goes up.
    on_released: (action: string, f: () -> ()) -> Connection,
}

-- Ray casts, impulses and velocities, characters and contacts.
declare physics: {
    -- The closest hit along a ray against bodies whose groups intersect `mask` (default: all), or nil.
    raycast: (origin: vector, direction: vector, max_distance: number, mask: number?) -> { entity: Entity?, point: vector, normal: vector, distance: number }?,
    -- Applies an impulse (N·s) to a dynamic body at its centre of mass, at the next step; a body spawned this frame gets it as it starts.
    impulse: (e: Entity, impulse: vector) -> (),
    -- A body's linear and angular velocity after the last step.
    velocity: (e: Entity) -> (vector, vector),
    -- Sets a dynamic body's linear velocity (m/s) and angular velocity (rad/s, default none) at the next step, in place of what it had; a body spawned this frame starts with them.
    set_velocity: (e: Entity, linear: vector, angular: vector?) -> (),
    -- Sets a character's desired velocity for the next step; `jump` jumps when it is on the ground.
    move_character: (e: Entity, velocity: vector, jump: boolean?) -> (),
    -- A character's state after the last step.
    character: (e: Entity) -> { position: vector, rotation: Quat, velocity: vector, on_ground: boolean, ground: string, ground_normal: vector, ground_entity: Entity? },
    -- Sets a vehicle's driver input from the next step until the next call: `throttle` and `steer` -1 to 1 (negative reverses or steers left), `brake` and `handbrake` 0 to 1; missing fields are 0, and a value out of range or not finite is an error.
    drive: (e: Entity, input: { throttle: number?, steer: number?, brake: number?, handbrake: number? }) -> (),
    -- A vehicle's state after the last step: forward speed (m/s, negative in reverse), engine rpm, gear (negative in reverse, 0 neutral), the input in effect, and each wheel in wheel order.
    vehicle: (e: Entity) -> { speed: number, rpm: number, gear: number, throttle: number, steer: number, brake: number, handbrake: number, wheels: { { on_ground: boolean, contact: Entity?, contact_point: vector, suspension_length: number, angular_velocity: number, steer_deg: number } } },
    -- Switches the entity's ragdoll from the next step until the next call or an edit of its `Ragdoll`: `animated` follows the animation, `simulated` goes limp, keeping its motion, and `powered` holds the animation with joint motors at `strength` (0 to 1, default 1). The shown pose blends to the ragdoll and back over the component's `blend_seconds`.
    ragdoll: (e: Entity, mode: "animated" | "simulated" | "powered", strength: number?) -> (),
    -- The entity's ragdoll after the last step: its mode and powered strength (0 otherwise), the frame its pose is placed in (the entity's pose when last targeted), the root part's world pose, and `calm`, true once every part has stayed slower than 0.05 m/s and 0.1 rad/s for 30 steps.
    ragdoll_state: (e: Entity) -> { mode: string, strength: number, position: vector, rotation: Quat, root_position: vector, root_rotation: Quat, calm: boolean },
    -- Applies an impulse (N·s) at the next step to the ragdoll part that follows `joint` (or the joint's nearest ancestor with a part); the ragdoll must be simulated or powered.
    ragdoll_impulse: (e: Entity, joint: string, impulse: vector) -> (),
    -- Calls `f` when two bodies start touching (or a body enters a sensor), after each physics step.
    on_contact: (f: (a: Entity, b: Entity, info: { point: vector, normal: vector, sensor: boolean }) -> ()) -> Connection,
    -- Calls `f` when two bodies stop touching (one may already be gone).
    on_contact_end: (f: (a: Entity, b: Entity, sensor: boolean) -> ()) -> Connection,
    -- Calls `f` when something starts touching `e` (or enters it, for a sensor).
    on_touch: (e: Entity, f: (other: Entity, info: { point: vector, normal: vector, sensor: boolean }) -> ()) -> Connection,
}

-- Sound playback.
declare audio: {
    -- Plays a sound asset once, at a world position or (without `at`) non-spatially; volume defaults to 1, and `bus` to the project's default bus.
    play: (clip: string, at: vector?, volume: number?, bus: string?) -> (),
    -- Sets the playback speed of `e`'s AudioSource (its `rate` field), above 0: 1 is normal, the pitch shifts with the speed, and it plays at most 16 times as fast. Its playing sound follows, and a sound it starts later plays at that rate.
    set_rate: (e: Entity, rate: number) -> (),
    -- Tweens a mixer bus's (or send's) volume to `db` decibels (0 is unchanged) over `seconds`, at once by default.
    set_bus_volume: (bus: string, db: number, seconds: number?) -> (),
    -- Tweens parameters of a bus's effect over `seconds` (at once by default). `index` is the effect's place in the bus's `effects` list in real.toml, 1 for the first; `params` are its fields, such as `{ cutoff_hz = 600 }` or `{ mode = "high_pass" }`.
    set_effect: (bus: string, index: number, params: { [string]: number | string }, seconds: number?) -> (),
    -- Tweens the mixer to a snapshot from real.toml [audio.snapshots] over `seconds` (at once by default); `"default"` returns to the graph's own values.
    snapshot: (name: string, seconds: number?) -> (),
    -- A mixer bus's (or send's) output over the last frame, after its effects and volume, in decibels (-60 is silence). It measures live audio, so it is frame-only: calling it during a fixed step (`time.on_step`, `time.on_post_step`, or a thread resumed there) is an error, because the simulation would no longer replay.
    levels: (bus: string) -> { peak_db: number, rms_db: number },
}

-- Animation graphs: parameters, states and joints.
declare anim: {
    -- Sets a float (number) or bool parameter of the graph `e`'s Animator plays, at once. An unknown parameter or a value of the wrong type is an error listing the graph's parameters.
    set: (e: Entity, param: string, value: number | boolean) -> (),
    -- A parameter of `e`'s graph: a number for a float parameter, a boolean for a bool, and for a trigger whether it is set.
    get: (e: Entity, param: string) -> number | boolean,
    -- Sets a trigger of `e`'s graph; it stays set until a transition that tests it fires.
    trigger: (e: Entity, param: string) -> (),
    -- The state a layer of `e`'s graph is in, or fading into (the first layer by default).
    state: (e: Entity, layer: string?) -> string,
    -- A joint of `e`'s skin in world space: the last step's pose, placed by `e`'s transform from the start of that step (so it trails that step's root motion). Its position and rotation.
    joint: (e: Entity, joint: string) -> (vector, Quat),
}

-- The heads-up display.
declare ui: {
    -- Sets the text of an entity's HudText component. It shows in this frame.
    set_text: (e: Entity, text: string) -> (),
}

-- Simulation time, its scale, and per-frame and per-step callbacks.
declare time: {
    -- Simulation time in seconds (advances by the fixed step).
    now: () -> number,
    -- Sets how fast simulation time runs against frame time, from the next fixed steps counted: 1 is normal, 0.5 half speed, and 0 pauses (no fixed steps run, so physics and `on_step` stop while `on_frame` goes on); 0 to 10. A frame still runs at most five fixed steps, so at 60 frames a second a scale above 5 runs as 5. A restart sets it back to 1.
    set_scale: (scale: number) -> (),
    -- The time scale in effect (1 unless `time.set_scale` changed it).
    scale: () -> number,
    -- The time of the current frame in seconds (variable).
    delta: () -> number,
    -- The number of frames run so far.
    frame: () -> number,
    -- Calls `f` once per frame, before simulation, with the frame time.
    on_frame: (f: (dt: number) -> ()) -> Connection,
    -- Calls `f` on every fixed step, before physics, with the step time.
    on_step: (f: (dt: number) -> ()) -> Connection,
    -- Calls `f` on every fixed step, after physics and contacts, with the step time.
    on_post_step: (f: (dt: number) -> ()) -> Connection,
    -- Calls `f` once per frame after the last fixed step, with the frame time, once the frame's drawn poses are known (`Entity:drawn_transform`). Move cameras and anything else that follows what is drawn here. A physics body moved here is drawn moved after the next step, and an entity under one from the next frame.
    on_late_frame: (f: (dt: number) -> ()) -> Connection,
}

-- Script threads: waiting, spawning and deferring.
declare task: {
    -- Suspends this script thread for `seconds` (default: until the next step) and returns the time that passed.
    wait: (seconds: number?) -> number,
    -- Runs `f` in a new script thread now; it continues here when `f` first waits or ends.
    spawn: (f: (...any) -> ...any, ...any) -> thread,
    -- Runs `f` in a new script thread at the end of the current cycle.
    defer: (f: (...any) -> ...any, ...any) -> thread,
    -- Runs `f` in a new script thread after `seconds` of simulation time.
    delay: (seconds: number, f: (...any) -> ...any, ...any) -> thread,
    -- Cancels a thread made by task.spawn, task.defer or task.delay, or one waiting in task.wait.
    cancel: (t: thread) -> (),
}

-- ProcGraph builders and procedural regeneration.
declare proc: {
    -- Starts recording a ProcGraph; a builder script returns it.
    graph: (name: string, options: { seed: number? }?) -> Graph,
    -- Regenerates the procedural source with this stable id using `seed` (applied at the end of the frame).
    regenerate: (source_id: string, seed: number) -> (),
}

-- World streaming: the loaded cells and their load and unload events.
declare stream: {
    -- Calls `f` for each cell that loads, before `time.on_step`, in key order. Cells loaded before the script started fire nothing; read `stream.cells()` at start.
    on_loaded: (f: (cell: { key: string, coord: { number }, min: vector, max: vector, sources: { string }, version: string }) -> ()) -> Connection,
    -- Calls `f` for each cell that unloads, before the loads of the same step, in key order.
    on_unloaded: (f: (cell: { key: string, coord: { number }, min: vector, max: vector, sources: { string }, version: string }) -> ()) -> Connection,
    -- The loaded cells, in key order.
    cells: () -> { { key: string, coord: { number }, min: vector, max: vector, sources: { string }, version: string } },
    -- True if cell `key` (`c/<x>_<z>`) is loaded.
    is_loaded: (key: string) -> boolean,
    -- Tools only: keeps cell `key` loaded whatever the focuses, until `stream.release`; it loads at the streaming delay.
    load: (key: string) -> (),
    -- Tools only: lets a cell kept by `stream.load` unload when no focus wants it.
    release: (key: string) -> (),
}

-- Scene switches, scenes loaded beside the main one, and entities kept across switches.
declare scene: {
    -- Unloads every scene and loads `name` in their place, keeping the kept entities; the change applies at the end of a frame.
    switch: (name: string) -> SceneLoad,
    -- Loads `name` beside the loaded scenes; it applies at the end of a frame.
    load: (name: string) -> SceneLoad,
    -- Unloads a scene that scene.load added, at the end of this frame.
    unload: (name: string) -> (),
    -- The main scene: the entry scene at start, then the last one switched to.
    current: () -> string,
    -- The loaded scenes: the main scene, then the added ones in load order.
    loaded: () -> {string},
    -- Every scene the game can load (real.toml [scenes] and the entry scene), sorted.
    list: () -> {string},
    -- Keeps a root entity, with its subtree, across scene switches; `false` stops keeping it.
    keep: (entity: Entity, keep: boolean?) -> (),
    -- True if the entity is kept across scene switches.
    is_kept: (entity: Entity) -> boolean,
}

-- Commands (tools context only): the same registry the CLI, editor and agents use.
declare command: {
    -- Runs a registered command as this script (undoable, logged with the script's path).
    run: (name: string, args: { [string]: any }?, dry_run: boolean?) -> { ok: boolean, data: any, changes: number, diagnostics: { { code: string, message: string } } },
}

-- Writes a warning to the log and the console.
declare function warn(...: any): ()

-- The running script: its project-relative path, its context, and the entity
-- whose ScriptRef started it (nil for modules and scripts started directly).
declare script: {
    path: string,
    context: string,
    entity: Entity?,
}

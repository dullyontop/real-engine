--!strict
-- generator.d.luau: the Luau API of generator scripts (scripts/generators/).
-- Generated by re_script::generator::definitions(); do not edit.
-- Load it with: luau-lsp analyze --definitions=@generator=generator.d.luau --flag:LuauSolverV2=true

declare extern type Quat with
    read x: number
    read y: number
    read z: number
    read w: number
    function inverse(self): Quat
    function rotate(self, v: vector): vector
    function to_euler(self): (number, number, number)
    -- q1 * q2 composes rotations; q * v rotates a vector.
    __mul: ((Quat, Quat) -> Quat) & ((Quat, vector) -> vector)
    function __eq(self, other: Quat): boolean
    function __tostring(self): string
end

declare extern type Color with
    read r: number
    read g: number
    read b: number
    read a: number
    function __eq(self, other: Color): boolean
    function __tostring(self): string
end

-- The random numbers of one evaluation (`ctx.rng`): a PCG32 on the node's seed.
declare extern type GeneratorRng with
    -- A number in [0, 1).
    function next(self): number
    -- A whole number from `lo` to `hi`, both included.
    function int(self, lo: number, hi: number): number
    -- An independent generator for stream `n`.
    function fork(self, n: number): GeneratorRng
end

-- What a node's `eval` gets as `ctx`.
declare extern type GeneratorContext with
    -- The node's id in its graph.
    read node: string
    -- The version of the kind the node was written for.
    read version: number
    -- The node's seed, a whole number below 2^53.
    read seed: number
    read rng: GeneratorRng
    -- Adds a line to the node's report (`print` does too).
    function log(self, text: string): ()
end

-- A parameter declaration made by `proc.param`.
declare extern type GeneratorParam with
    read type: string
end

-- A node kind's declaration made by `proc.node`.
declare extern type GeneratorNode with
    read kind: string
    read version: number
end

-- Node kinds written in Luau (ADR-0043).
declare proc: {
    -- Declares the node kind of a file directly in scripts/generators/, which returns it. `eval` gets the inputs by port name and the parameters by name.
    node: (decl: { kind: string, version: number, oldest: number?, doc: string, inputs: { { name: string, type: string | { string }, required: boolean?, doc: string? } }?, output: "field" | "points" | "mesh" | "fragment" | "shapes" | "path", params: { [string]: GeneratorParam }?, uses_seed: boolean?, migrate: ((from: number, params: { [string]: any }) -> { [string]: any })?, eval: (ctx: GeneratorContext, inputs: { [string]: any }, params: { [string]: any }) -> any }) -> GeneratorNode,
    -- Parameter declarations, by type.
    param: {
        number: (opts: { default: number?, min: number?, max: number?, doc: string? }?) -> GeneratorParam,
        integer: (opts: { default: number?, min: number?, max: number?, doc: string? }?) -> GeneratorParam,
        bool: (opts: { default: boolean?, doc: string? }?) -> GeneratorParam,
        string: (opts: { default: string?, doc: string? }?) -> GeneratorParam,
        enum: (opts: { values: { string }, default: string?, doc: string? }) -> GeneratorParam,
        vec3: (opts: { default: vector?, doc: string? }?) -> GeneratorParam,
    },
}

-- Rotations.
declare quat: {
    -- The rotation that does nothing.
    identity: () -> Quat,
    -- A rotation from angles in radians: yaw `y`, then pitch `x`, then roll `z`.
    from_euler: (x: number, y: number, z: number) -> Quat,
    -- A rotation of `angle` radians around `axis` (normalised here).
    from_axis_angle: (axis: vector, angle: number) -> Quat,
    -- The rotation that turns -Z towards `forward`, keeping `up` (default +Y) up.
    look_at: (forward: vector, up: vector?) -> Quat,
    -- Spherical interpolation from `a` (t = 0) to `b` (t = 1).
    slerp: (a: Quat, b: Quat, t: number) -> Quat,
}

-- Linear colours.
declare color: {
    -- A linear colour; alpha defaults to 1.
    new: (r: number, g: number, b: number, a: number?) -> Color,
}

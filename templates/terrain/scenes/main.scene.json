        "Light": {
          "kind": "Directional",
          "color": [1.0, 1.0, 1.0, 1.0],
          "intensity": 1.2,
          "range": 20.0,
          "shadows": true
        },
        "Transform": {
          "translation": [0.0, 0.0, 0.0],
          "rotation": [-0.5025189, 0.30151135, 0.10050379, 0.8040303],
          "scale": [1.0, 1.0, 1.0]
        }
      }
    },
    {
      "id": "terrain",
      "name": "Terrain",
      "components": {
        "GraphSource": {
          "graph": "",
          "builder": "scripts/tools/terrain_graph.luau",
          "params": ""
        },
        "Procedural": {
          "generator": "graph",
          "seed": {{seed}},
          "version": 1
        },
        "Transform": {
          "translation": [0.0, 0.0, 0.0],
          "rotation": [0.0, 0.0, 0.0, 1.0],
          "scale": [1.0, 1.0, 1.0]
        }
      }
    }
  ]
}

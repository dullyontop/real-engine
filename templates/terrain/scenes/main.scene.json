{
  "$schema": "../schemas/scene.schema.json",
  "format": "real-engine/scene",
  "version": 1,
  "entities": [
    {
      "id": "camera",
      "name": "Camera",
      "components": {
        "Camera": {
          "fov_y_deg": 60.0,
          "near": 0.1,
          "far": 1000.0,
          "active": true
        },
        "Transform": {
          "translation": [0.0, 60.0, 110.0],
          "rotation": [-0.25881904, 0.0, 0.0, 0.9659259],
          "scale": [1.0, 1.0, 1.0]
        }
      }
    },
    {
      "id": "sun",
      "name": "Sun",
